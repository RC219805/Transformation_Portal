      "expected_plan_status": "success",
      "expected_planned_backend": "da3",
      "expected_resolved_model": "da3_metric",
      "expected_stage_registry_ids": [
        "tp.stage.lux.preprocess.v1",
        "tp.stage.lux.depth.v1",
        "tp.stage.lux.materials_v3.v1",
        "tp.stage.lux.pbr.v1",
        "tp.stage.lux.v2.v1",
        "tp.stage.lux.output.v1"
      ],
      "expected_requested_artifacts": [
        "depth_u16_png", "depth_metadata_json", "combined_manifest_json", "batch_manifest_json",
        "materials_v3_masks", "pbr_maps", "v2_enhanced_image", "run_card"
      ],
