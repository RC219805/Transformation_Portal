{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://transformation-portal.com/schemas/water-ground-truth-v0.json",
  "title": "Water Detection Ground Truth v0",
  "description": "Schema for water detection ground truth annotations (pool/ocean labels)",
  "type": "object",
  "required": ["root", "images"],
  "properties": {
    "root": {
      "type": "string",
      "description": "Base path for images (relative to this JSON file)"
    },
    "images": {
      "type": "object",
      "description": "Map of image paths to ground truth labels",
      "patternProperties": {
        "^.*\\.(jpg|jpeg|png|JPG|JPEG|PNG)$": {
          "type": "object",
          "required": ["label", "should_detect"],
          "properties": {
            "label": {
              "type": "string",
              "enum": ["pool", "ocean"],
              "description": "Water type classification"
            },
            "should_detect": {
              "type": "boolean",
              "description": "Whether water should be detected (false for hard negatives)"
            },
            "difficulty": {
              "type": "string",
              "enum": ["easy", "medium", "hard"],
              "description": "Subjective difficulty rating for detection"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Additional tags for categorization (e.g., low-light, reflection, waves)"
            },
            "bbox": {
              "type": "object",
              "description": "Optional bounding box for water region",
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": {"type": "number", "minimum": 0},
                "y": {"type": "number", "minimum": 0},
                "width": {"type": "number", "minimum": 0},
                "height": {"type": "number", "minimum": 0}
              }
            },
            "expected_mask_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Expected fraction of image covered by water mask (0.0-1.0)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
