TP_FASTAPI_ORIGIN=http://127.0.0.1:8000
TP_BACKEND_API_KEY=replace-with-strong-backend-token
TP_FRONTDOOR_USERS_FILE=/absolute/path/to/frontdoor-users.json
TP_CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
TP_CF_ACCESS_AUD=replace-with-access-application-aud
# Optional local-dev fallback only:
# TP_FRONTDOOR_USERS_JSON=[{"username":"admin","password_hash":"$argon2id$...","access_email":"admin@example.com","role":"admin"}]
TP_FRONTDOOR_SESSION_DB=/tmp/transformation-portal-frontdoor-sessions.db
TP_FRONTDOOR_SESSION_SCALING_MODE=single_instance
TP_ALLOW_LOCAL_ACCESS_BYPASS=0
