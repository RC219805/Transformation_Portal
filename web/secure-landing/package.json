{
  "name": "secure-landing-frontdoor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "preinstall": "node ./scripts/check-node-version.mjs",
    "build:portal": "node ./scripts/guard-runtime.mjs && node ./scripts/build-portal-bundle.mjs",
    "dev": "npm run build:portal && node ./scripts/guard-runtime.mjs && next dev",
    "build": "npm run build:portal && node ./scripts/guard-runtime.mjs && next build",
    "start": "node ./scripts/guard-runtime.mjs && node ./scripts/start-standalone.mjs",
    "seed-frontdoor-user": "node ./scripts/guard-runtime.mjs && node ./scripts/seed-frontdoor-user.mjs",
    "test": "npm run build:portal && node ./scripts/guard-runtime.mjs && node --experimental-specifier-resolution=node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.0.0",
    "next": "16.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
