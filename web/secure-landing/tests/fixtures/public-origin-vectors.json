{
  "schema": "tp.frontdoor.public_origin_vectors.v1",
  "description": "Shared vectors for TP_FRONTDOOR_PUBLIC_ORIGIN. They drive isCanonicalPublicOrigin in web/secure-landing/lib/config.js and _is_canonical_public_origin in scripts/validation/check_frontdoor_vercel_env.py, so the two validators cannot drift. Non-ASCII and control characters are stored as JSON escapes.",
  "accepted": [
    "https://portal.example.com",
    "https://portal.example.com:8443",
    "https://portal.example.com:1",
    "https://portal.example.com:65535",
    "https://a.b.c.example.co",
    "https://portal-1.example-site.com",
    "https://9lives.example.com",
    "https://xn--bcher-kva.example"
  ],
  "rejected": [
    { "value": "http://portal.example.com", "why": "scheme is not https" },
    { "value": "HTTPS://portal.example.com", "why": "upper-case scheme" },
    { "value": "https://Portal.example.com", "why": "upper-case host" },
    { "value": "https://portal.example.com/", "why": "trailing slash" },
    { "value": "https://portal.example.com/portal", "why": "path" },
    { "value": "https://portal.example.com?view=build", "why": "query" },
    { "value": "https://portal.example.com?", "why": "empty query" },
    { "value": "https://portal.example.com#top", "why": "fragment" },
    { "value": "https://portal.example.com#", "why": "empty fragment" },
    { "value": "https://operator@portal.example.com", "why": "userinfo" },
    { "value": "https://portal.example.com:443", "why": "default port" },
    { "value": "https://portal.example.com:0443", "why": "port with leading zero" },
    { "value": "https://portal.example.com:0", "why": "port zero" },
    { "value": "https://portal.example.com:65536", "why": "port out of range" },
    { "value": "https://portal.example.com:", "why": "bare port separator" },
    { "value": "https://portal.example.com:8443x", "why": "characters after the port" },
    { "value": "https://portal", "why": "single-label host" },
    { "value": "https://localhost", "why": "loopback name" },
    { "value": "https://localhost:3000", "why": "loopback name with port" },
    { "value": "https://app.localhost", "why": "name under .localhost" },
    { "value": "https://127.0.0.1", "why": "IPv4 literal" },
    { "value": "https://127.0.0.1:3000", "why": "IPv4 literal with port" },
    { "value": "https://[::1]", "why": "IPv6 literal" },
    { "value": "https://[::1]:3000", "why": "IPv6 literal with port" },
    { "value": "https://0x7f.1", "why": "hexadecimal IPv4 shorthand" },
    { "value": "https://portal.example.123", "why": "numeric last label" },
    { "value": "https://*.example.com", "why": "wildcard" },
    { "value": "https://portal.example.com.", "why": "trailing dot" },
    { "value": "https://portal..example.com", "why": "empty label" },
    { "value": "https://-portal.example.com", "why": "label starts with a hyphen" },
    { "value": "https://portal-.example.com", "why": "label ends with a hyphen" },
    { "value": "https://portal_app.example.com", "why": "underscore in a label" },
    { "value": "https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com", "why": "label longer than 63 characters" },
    { "value": "https://b\u00fccher.example", "why": "Unicode host; the punycode form is the accepted one" },
    { "value": "https://\uff11\uff12\uff17.0.0.1", "why": "full-width digits" },
    { "value": "https://portal.example.com\u200b", "why": "trailing zero-width space" },
    { "value": "\ufeffhttps://portal.example.com", "why": "leading byte-order mark" },
    { "value": "\u00a0https://portal.example.com", "why": "leading no-break space" },
    { "value": "https://portal\t.example.com", "why": "tab inside the host" },
    { "value": "https://portal.example.com evil.example", "why": "space inside the value" },
    { "value": "https://portal.example.com,https://other.example.com", "why": "more than one origin" },
    { "value": "https://", "why": "no host" },
    { "value": "https:///evil.example", "why": "empty authority" },
    { "value": "//portal.example.com", "why": "no scheme" },
    { "value": "portal.example.com", "why": "bare host" }
  ],
  "trimmed": [
    { "value": "  https://portal.example.com", "origin": "https://portal.example.com" },
    { "value": "https://portal.example.com\n", "origin": "https://portal.example.com" },
    { "value": "\t https://portal.example.com:8443 \r\n", "origin": "https://portal.example.com:8443" }
  ]
}
