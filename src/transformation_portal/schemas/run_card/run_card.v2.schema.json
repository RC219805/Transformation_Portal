{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rc219805.github.io/Transformation_Portal/docs/schemas/run_card/run_card.v2.schema.json",
  "title": "Run Card v2",
  "description": "Deterministic run card contract for lux_depth_v3 batch execution metadata with transparency-grade artifact commitments.",
  "type": "object",
  "required": [
    "artifact_index",
    "artifact_tree",
    "backend_selection",
    "backend_summary",
    "batch_id",
    "config_fingerprint",
    "end_time",
    "environment",
    "error_count",
    "git_revision",
    "outliers",
    "run_card_version",
    "runtime_stats",
    "start_time",
    "success_count",
    "total_images"
  ],
  "properties": {
    "run_card_version": {
      "type": "string",
      "const": "v2"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "config_fingerprint": {
      "type": "object",
      "required": [
        "apex_strict_mode",
        "backend_requested",
        "backend_resolved",
        "canonical_json",
        "device_requested",
        "device_resolved",
        "depth_device",
        "depth_quantization",
        "hash_algorithm",
        "model_variant",
        "preset",
        "preset_requested",
        "preset_resolved",
        "quality_tier",
        "sha256",
        "strict_inputs",
        "strict_segmentation",
        "v2_device",
        "v2_preset",
        "v2_upscaler_backend"
      ],
      "properties": {
        "model_variant": {
          "type": "string",
          "minLength": 1
        },
        "depth_quantization": {
          "type": "string",
          "minLength": 1
        },
        "depth_device": {
          "type": "string",
          "minLength": 1
        },
        "preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "preset_requested": {
          "type": [
            "string",
            "null"
          ]
        },
        "preset_resolved": {
          "type": "string",
          "minLength": 1
        },
        "backend_requested": {
          "type": "string",
          "minLength": 1
        },
        "backend_resolved": {
          "type": "string",
          "minLength": 1
        },
        "device_requested": {
          "type": "string",
          "minLength": 1
        },
        "device_resolved": {
          "type": "string",
          "minLength": 1
        },
        "quality_tier": {
          "type": "string",
          "minLength": 1
        },
        "raw_ingest_profile": {
          "type": "string",
          "minLength": 1
        },
        "raw_ingest_settings_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "strict_inputs": {
          "type": "boolean"
        },
        "strict_segmentation": {
          "type": "boolean"
        },
        "apex_strict_mode": {
          "type": "boolean"
        },
        "v2_preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "v2_device": {
          "type": [
            "string",
            "null"
          ]
        },
        "v2_upscaler_backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth_pro_python_executable": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_python_executable": {
          "type": [
            "string",
            "null"
          ]
        },
        "da3_python_executable": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_artifact_filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_depth_units": {
          "type": "string",
          "minLength": 1
        },
        "depth_png_encoding": {
          "type": "string",
          "minLength": 1
        },
        "materials_v3_enabled": {
          "type": "boolean"
        },
        "material_segmentation_enabled": {
          "type": "boolean"
        },
        "material_segmentation_backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "pbr_enabled": {
          "type": "boolean"
        },
        "run_card_version": {
          "type": "string",
          "minLength": 1
        },
        "run_card_include_proofs": {
          "type": "boolean"
        },
        "emit_run_card": {
          "type": "boolean"
        },
        "vlm_captioning_enabled": {
          "type": "boolean"
        },
        "vlm_captioning_backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "vlm_captioning_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "vlm_captioning_proxy_format": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "png",
            "jpeg",
            null
          ]
        },
        "vlm_captioning_max_side_px": {
          "type": "integer",
          "minimum": 1
        },
        "fastvlm_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "hash_algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "canonical_json": {
          "type": "string",
          "minLength": 2
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "backend_selection": {
      "type": "object",
      "required": [
        "device",
        "model_id",
        "requested",
        "resolved"
      ],
      "properties": {
        "requested": {
          "type": "string",
          "minLength": 1
        },
        "resolved": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_artifact_filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "logical_backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_engine": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "backend_summary": {
      "type": "object",
      "required": [
        "fallback_images",
        "final_backends_used",
        "semantic_fallback_images",
        "operational_fallback_images",
        "primary_backend",
        "requested_backend"
      ],
      "properties": {
        "requested_backend": {
          "type": "string",
          "minLength": 1
        },
        "primary_backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "final_backends_used": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fallback_images": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_fallback_images": {
          "type": "integer",
          "minimum": 0
        },
        "operational_fallback_images": {
          "type": "integer",
          "minimum": 0
        },
        "requested_backend_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "honored",
            "not_honored",
            null
          ]
        },
        "requested_backend_defect": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "model_contract": {
      "type": "object",
      "required": [
        "accelerator_kind",
        "backend_kind",
        "canonical_model_key",
        "fallback_chain",
        "license_id",
        "manifest_schema_version",
        "non_commercial_ok",
        "requested_model_selector",
        "requires_non_commercial_ok",
        "resolved_repo_id",
        "usage_class"
      ],
      "properties": {
        "contract_kind": {
          "type": "string",
          "enum": [
            "hf_revision",
            "local_checkpoint"
          ]
        },
        "requested_model_selector": {
          "type": "string",
          "minLength": 1,
          "description": "Selector supplied by the caller, or 'default' when no model selector was supplied. The deprecated 'da3' selector remains distinct and resolves to da3_research during its warning cycle."
        },
        "resolution_reason": {
          "type": "string",
          "minLength": 1,
          "description": "Deterministic explanation of the model selection path."
        },
        "canonical_model_key": {
          "type": "string",
          "minLength": 1
        },
        "resolved_repo_id": {
          "type": "string",
          "minLength": 1
        },
        "resolved_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "model_artifact_filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "model_artifact_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "license_id": {
          "type": "string",
          "minLength": 1
        },
        "usage_class": {
          "type": "string",
          "minLength": 1
        },
        "requires_non_commercial_ok": {
          "type": "boolean"
        },
        "non_commercial_ok": {
          "type": "boolean"
        },
        "accept_apple_depth_pro_research_license": {
          "type": "boolean"
        },
        "backend_kind": {
          "type": "string",
          "minLength": 1
        },
        "accelerator_kind": {
          "type": "string",
          "minLength": 1
        },
        "fallback_chain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "manifest_schema_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "contract_kind"
              ]
            }
          },
          "then": {
            "required": [
              "resolved_revision"
            ],
            "properties": {
              "resolved_revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "contract_kind": {
                "const": "hf_revision"
              }
            },
            "required": [
              "contract_kind"
            ]
          },
          "then": {
            "required": [
              "resolved_revision"
            ],
            "properties": {
              "resolved_revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "contract_kind": {
                "const": "local_checkpoint"
              }
            },
            "required": [
              "contract_kind"
            ]
          },
          "then": {
            "required": [
              "model_artifact_filename",
              "model_artifact_sha256"
            ],
            "properties": {
              "model_artifact_filename": {
                "type": "string",
                "minLength": 1
              },
              "model_artifact_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "licensing": {
      "type": "object",
      "required": [
        "models",
        "non_commercial_active",
        "research_acknowledgement_required",
        "schema_version",
        "software_license_tier"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "software_license_tier": {
          "type": "string",
          "enum": [
            "commercial",
            "research_or_non_commercial"
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "license",
              "runtime_role",
              "requires_non_commercial_ok"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "runtime_role": {
                "type": "string",
                "minLength": 1
              },
              "usage_class": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "requires_non_commercial_ok": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "non_commercial_active": {
          "type": "boolean"
        },
        "research_acknowledgement_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "machine",
        "platform",
        "python_version"
      ],
      "properties": {
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "git_revision": {
      "type": "object",
      "required": [
        "v2",
        "v3"
      ],
      "properties": {
        "v2": {
          "type": [
            "string",
            "null"
          ]
        },
        "v3": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "runtime_stats": {
      "type": "object",
      "required": [
        "count",
        "max",
        "mean",
        "median",
        "min",
        "total"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "mean": {
          "type": "number",
          "minimum": 0
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "median": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "outliers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "image",
          "metadata"
        ],
        "properties": {
          "image": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object",
            "required": [
              "is_outlier",
              "median_runtime_s",
              "ratio_to_median",
              "runtime_s",
              "threshold_multiplier"
            ],
            "properties": {
              "is_outlier": {
                "type": "boolean"
              },
              "runtime_s": {
                "type": "number",
                "minimum": 0
              },
              "median_runtime_s": {
                "type": "number",
                "minimum": 0
              },
              "ratio_to_median": {
                "type": "number",
                "minimum": 0
              },
              "threshold_multiplier": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "total_images": {
      "type": "integer",
      "minimum": 0
    },
    "success_count": {
      "type": "integer",
      "minimum": 0
    },
    "error_count": {
      "type": "integer",
      "minimum": 0
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "effective_config": {
      "type": "object",
      "additionalProperties": true
    },
    "result_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "image",
          "status"
        ],
        "properties": {
          "image": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "backend": {
            "type": [
              "string",
              "null"
            ]
          },
          "runtime_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "manifest_path": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "quality_gate": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "passed": {
                "type": "boolean"
              },
              "failure_codes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "details": {
                "type": "object",
                "properties": {
                  "metrics": {
                    "type": "object"
                  },
                  "thresholds": {
                    "type": "object"
                  },
                  "shape_context": {
                    "type": "object"
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "capability": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "requested_backend": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "executed_backend": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "availability_state": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "synthetic_output": {
                "type": "boolean"
              },
              "stub_mode": {
                "type": "boolean"
              },
              "fallback_executed": {
                "type": "boolean"
              },
              "model_repo_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model_revision": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "asset_bundle_version": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "segmentation_status": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              },
              "enabled": {
                "type": "boolean"
              },
              "backend": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "strict_backend": {
                "type": "boolean"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mask_artifact_path": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "mask_count": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "confidence_summary": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "failure_code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "failure_details": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "pixel_ops_passthrough": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "materials_summary": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "masks_generated",
                  "mask_count",
                  "pixel_ops_applied",
                  "pixel_ops_applied_count",
                  "blocked_count",
                  "passthrough_code"
                ],
                "properties": {
                  "masks_generated": {
                    "type": "boolean"
                  },
                  "mask_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "pixel_ops_applied": {
                    "type": "boolean"
                  },
                  "pixel_ops_applied_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "blocked_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "passthrough_code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "performance_warnings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "code",
                    "severity",
                    "message",
                    "details"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "APEX_MATERIALS_SEGMENTATION_DOMINATES_NO_PIXEL_OPS"
                      ]
                    },
                    "severity": {
                      "type": "string",
                      "enum": [
                        "advisory"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "details": {
                      "type": "object",
                      "required": [
                        "sam2_runtime_ms",
                        "total_runtime_ms",
                        "sam2_runtime_share",
                        "pixel_ops_applied_count",
                        "mask_count"
                      ],
                      "properties": {
                        "sam2_runtime_ms": {
                          "type": "number",
                          "minimum": 0
                        },
                        "total_runtime_ms": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
