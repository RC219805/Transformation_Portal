# Transformation Portal - root environment template
#
# Copy this file to `.env` for Docker Compose or local FastAPI backend runs.
# The root `.env` is the Docker/FastAPI template. Frontdoor-only auth and
# session variables belong in `web/secure-landing/.env.example`. Managed
# paid-pilot provider gates use a private env file outside the repository; see
# `docs/deployment/managed_paid_pilot_staging_runbook.md`.
#
# Docker Compose reads `.env` with `required: false`, so missing entries fall
# back to Compose or in-code defaults. Set `TP_API_KEY` for any non-throwaway
# run.

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Shared secret for protected /v1 endpoints. When unset AND
# TP_ENFORCE_JOB_API_KEY is true (the default), the orchestrator returns
# 503 AUTH_CONFIGURATION_ERROR for protected routes. Generate with:
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"
TP_API_KEY=

# Whether protected /v1 endpoints enforce the API key. Default in app.py: true.
# Set to "false" only for development against an unauthenticated orchestrator.
# TP_ENFORCE_JOB_API_KEY=true

# HTTP header carrying the API key. Default: x-api-key. Lower-case, single token.
# TP_API_KEY_HEADER=x-api-key

# ---------------------------------------------------------------------------
# HTTP trust, path boundaries, and request limits
# ---------------------------------------------------------------------------

# Comma-separated CORS origins accepted by the FastAPI origin. Defaults in
# app.py: http://localhost,http://localhost:3000,http://127.0.0.1:8000.
# TP_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:8000

# TrustedHost middleware allowlist. Append tunnel or deployment hostnames before
# backend startup; keep TP_ENABLE_TRUSTED_HOSTS=true outside exceptional local
# troubleshooting.
# TP_TRUSTED_HOSTS=localhost,127.0.0.1,::1,testserver
# TP_ENABLE_TRUSTED_HOSTS=true

# Only enable forwarded-client-IP trust behind a controlled proxy, then list the
# trusted proxy IPs explicitly.
# TP_TRUST_X_FORWARDED_FOR=false
# TP_TRUSTED_PROXY_IPS=

# Request and admission limits. Defaults in app.py: 1 MiB request/upload cap,
# 256 upload files, 32 multipart fields, 60 requests/minute, 4 concurrent jobs.
# TP_MAX_REQUEST_BYTES=1048576
# TP_PORTAL_MAX_UPLOAD_REQUEST_BYTES=1048576
# TP_PORTAL_UPLOAD_MAX_FILES=256
# TP_PORTAL_UPLOAD_MAX_FIELDS=32
# TP_PORTAL_UPLOAD_MAX_PART_BYTES=1048576
# TP_RATE_LIMIT_PER_MINUTE=60
# TP_MAX_CONCURRENT_JOBS=4

# Comma-separated filesystem roots the backend may read from or write to. Defaults
# are the repo root plus platform temp aliases. Keep TP_PORTAL_UPLOAD_ROOT inside
# TP_ALLOWED_INPUT_ROOTS.
# TP_ALLOWED_INPUT_ROOTS=.
# TP_ALLOWED_OUTPUT_ROOTS=.

# Job retention and worker lease tunables. Canonical worker names are TP_WORKER_*;
# legacy TP_ORCHESTRATOR_WORKER_* names are only fallback compatibility.
# TP_JOB_RETENTION_SECONDS=3600
# TP_CLEANUP_INTERVAL_SECONDS=60
# TP_JOB_CLEANUP_SCAN_LIMIT=1000
# TP_CANCEL_GRACE_SECONDS=5
# TP_JOB_LIST_LIMIT=200
# TP_MAX_INDEXED_ARTIFACTS=200
# TP_WORKER_LEASE_SECONDS=300
# TP_WORKER_HEARTBEAT_SECONDS=30
# TP_WORKER_POLL_SECONDS=0.05
# TP_ORCHESTRATOR_WORKER_SHUTDOWN_GRACE_SECONDS=5
# TP_ORCHESTRATOR_RECLAIM_SWEEP_INTERVAL_SECONDS=5

# Local diagnostics. Leave disabled in normal local/production runs.
# TP_ENABLE_API_DOCS=false
# TP_READY_VERBOSE=false

# ---------------------------------------------------------------------------
# Docker Compose runtime
# ---------------------------------------------------------------------------

# Runtime UID/GID used by Dockerfile and docker-compose.yml. Keep these aligned
# with the `tp` user contract unless you need a host-specific bind-mount owner.
TP_UID=10001
TP_GID=10001

# Hardware device for Docker Compose service selection. One of: cpu | cuda | mps.
# This is read by docker-compose.yml and Dockerfile defaults. The Python
# orchestrator still uses its own runtime auto-detection unless a specific
# backend exposes a separate device selector.
DEVICE=cpu

# Optional subprocess runtime interpreter overrides. Most deploys leave these
# unset and let Lux Depth V3 auto-discover the repo-local runtime contract paths
# when present:
#   ./.runtime/Depth-Anything-3/.venv-da3/bin/python
#   ./.venv-depth-pro/bin/python
#   ./.venv-raw/bin/python
# TRANSFORMATION_PORTAL_DA3_PYTHON=
# TRANSFORMATION_PORTAL_DEPTH_PRO_PYTHON=
# TRANSFORMATION_PORTAL_RAW_PYTHON=

# ---------------------------------------------------------------------------
# Backend storage, queue, and artifact backends
# ---------------------------------------------------------------------------

# Job repository backend. Default: memory. Use postgres only after starting the
# Compose Postgres service and running `make db-upgrade`.
TP_ORCHESTRATOR_STATE_BACKEND=memory
# TP_DATABASE_URL=postgresql+asyncpg://tp:tp_dev_password@127.0.0.1:5432/transformation_portal

# Queue broker backend. Default: memory. Use redis only after starting the
# Compose Redis service.
TP_ORCHESTRATOR_QUEUE_BACKEND=memory
# TP_REDIS_URL=redis://127.0.0.1:6379/0
# TP_REDIS_KEY_PREFIX=tp:queue:

# Artifact store backend. Default: local. Leave TP_ARTIFACT_LOCAL_ROOT unset for
# host-side local runs, or set it to the Docker `tp_state` path below when you
# want container-local artifacts to survive Compose restarts.
TP_ARTIFACT_STORE=local
# TP_ARTIFACT_LOCAL_ROOT=/home/tp/.transformation_portal/artifacts
# TP_ARTIFACT_PREFIX=tp/artifacts
# TP_ARTIFACT_PRESIGN_EXPIRES_SECONDS=120
# TP_ARTIFACT_RETENTION_SECONDS=86400

# S3-compatible artifact store, including local MinIO. Required only when
# TP_ARTIFACT_STORE=s3.
# TP_ARTIFACT_BUCKET=tp-artifacts-pilot
# TP_ARTIFACT_ENDPOINT_URL=http://127.0.0.1:9000
# TP_ARTIFACT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=tp_minio
# AWS_SECRET_ACCESS_KEY=tp_minio_password

# ---------------------------------------------------------------------------
# Optional Compose services
# ---------------------------------------------------------------------------

# Local Postgres service defaults. These feed docker-compose.yml. They are not
# production secrets.
POSTGRES_DB=transformation_portal
POSTGRES_USER=tp
POSTGRES_PASSWORD=tp_dev_password
TP_POSTGRES_PUBLIC_PORT=127.0.0.1:5432

# Local Redis service default port binding.
TP_REDIS_PUBLIC_PORT=127.0.0.1:6379

# Local MinIO service defaults for the paid-pilot Compose profile. These are
# development-only credentials and bucket names.
MINIO_ROOT_USER=tp_minio
MINIO_ROOT_PASSWORD=tp_minio_password
TP_MINIO_API_PUBLIC_PORT=127.0.0.1:9000
TP_MINIO_CONSOLE_PUBLIC_PORT=127.0.0.1:9001
# TP_MINIO_IMAGE=minio/minio:latest
# TP_MINIO_MC_IMAGE=minio/mc:latest

# Test-only service URLs. Set these only for destructive local service contract
# tests; never point them at production or customer data.
# TP_TEST_POSTGRES_URL=postgresql+asyncpg://tp:tp_dev_password@127.0.0.1:5432/transformation_portal
# TP_TEST_REDIS_URL=redis://127.0.0.1:6379/0
# TP_TEST_S3_URL=http://127.0.0.1:9000
# TP_TEST_S3_BUCKET=tp-artifacts-pilot-test

# ---------------------------------------------------------------------------
# Portal surface served by FastAPI
# ---------------------------------------------------------------------------

# Filesystem root for staged multipart uploads. Default:
# <tmpdir>/transformation-portal/uploads.
# TP_PORTAL_UPLOAD_ROOT=

# Override the default Content-Security-Policy served with portal.html.
# Empty/unset uses DEFAULT_CSP from app.py.
# TP_CSP=

# Append-only audit log for portal events (job lifecycle, dispatch, etc.).
# Unset disables file logging; events still go to stdout via the Python logger.
# TP_PORTAL_EVENT_LOG_PATH=

# Append-only RUM telemetry log (browser-reported metrics).
# TP_PORTAL_RUM_LOG_PATH=

# ---------------------------------------------------------------------------
# Frontdoor boundary
# ---------------------------------------------------------------------------

# Root `.env` does not own managed-frontdoor auth/session settings. Use:
#   web/secure-landing/.env.example
# for TP_FASTAPI_ORIGIN, TP_BACKEND_API_KEY, TP_FRONTDOOR_USERS_FILE,
# TP_FRONTDOOR_SESSION_DB, TP_FRONTDOOR_SESSION_STORE, and related variables.

# ---------------------------------------------------------------------------
# Rollout / feature gates
# ---------------------------------------------------------------------------

# The backend exposes TP_PORTAL_* boolean and percentage gates for rolling out
# portal features. The set changes with active UI work; use `rg "TP_PORTAL_"`
# in app.py and web/secure-landing/tests for the live list before setting one.
