name: Validate Requirements Compilation

# This workflow ensures requirements are compiled with the correct Python version
# to maintain compatibility guarantees across Python 3.10, 3.11, and 3.12.

on:
  pull_request:
    paths:
      - 'requirements/*.txt'
      - 'requirements/*.in'
      - 'requirements/constraints.txt'
  push:
    branches:
      - main
    paths:
      - 'requirements/*.txt'
      - 'requirements/*.in'
      - 'requirements/constraints.txt'

jobs:
  validate-compilation:
    name: Validate Requirements Compiled with Python 3.10
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Check requirements headers
        id: check_headers
        run: |
          echo "Checking requirements file headers..."
          
          # Check if any file was compiled with wrong Python version
          WRONG_VERSION=$(grep -h "autogenerated by pip-compile with Python" requirements/*.txt | grep -v "Python 3.10" || true)
          
          if [ -n "$WRONG_VERSION" ]; then
            echo "❌ ERROR: Requirements compiled with wrong Python version!"
            echo ""
            echo "Found:"
            echo "$WRONG_VERSION"
            echo ""
            echo "Requirements MUST be compiled with Python 3.10 (minimum supported version)."
            echo ""
            echo "Current headers in requirements files:"
            grep "autogenerated by pip-compile with Python" requirements/*.txt
            echo ""
            echo "To fix this:"
            echo "1. Install Python 3.10: pyenv install 3.10.15"
            echo "2. Activate it: pyenv local 3.10.15"
            echo "3. Verify: python --version"
            echo "4. Recompile: cd requirements && make clean && make compile"
            echo ""
            echo "See requirements/COMPILATION_NOTES.md for details."
            exit 1
          fi
          
          echo "✓ All requirements compiled with Python 3.10"
      
      - name: Set up Python 3.10
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'
      
      - name: Install pip-tools
        run: |
          python -m pip install --upgrade pip
          pip install pip-tools
      
      - name: Verify requirements are up-to-date
        run: |
          cd requirements/
          make check
        continue-on-error: false
  
  test-installation:
    name: Test Installation on Python ${{ matrix.python-version }}
    runs-on: ubuntu-latest
    needs: validate-compilation
    
    strategy:
      matrix:
        python-version: ['3.10', '3.11', '3.12']
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      
      - name: Test requirements installation
        run: |
          python -m pip install --upgrade pip
          
          # Test base requirements
          echo "Testing base.txt on Python ${{ matrix.python-version }}..."
          pip install -r requirements/base.txt
          
          # Test critical imports
          python -c "import numpy; print(f'NumPy {numpy.__version__}')"
          python -c "import PIL; print(f'Pillow {PIL.__version__}')"
          python -c "import sklearn; print(f'scikit-learn {sklearn.__version__}')"
          
          # Test problematic packages from PR review
          python -c "import keyring; print(f'keyring {keyring.__version__}')" || echo "⚠️  keyring import failed"
          
          echo "✓ Base requirements work on Python ${{ matrix.python-version }}"
      
      - name: Test ML requirements
        run: |
          # Skip on Python 3.10 due to time constraints (ML packages are large)
          if [ "${{ matrix.python-version }}" != "3.10" ]; then
            echo "Testing ml.txt on Python ${{ matrix.python-version }}..."
            pip install -r requirements/ml.txt
            python -c "import torch; print(f'PyTorch {torch.__version__}')"
            echo "✓ ML requirements work on Python ${{ matrix.python-version }}"
          else
            echo "Skipping ML test on Python 3.10 (time constraint)"
          fi
        continue-on-error: true  # ML dependencies are optional
  
  security-check:
    name: Verify Security Constraints
    runs-on: ubuntu-latest
    needs: validate-compilation
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Verify CVE mitigations
        run: |
          echo "Checking security constraints..."
          
          # CVE-2024-27763: basicsr vulnerability
          if grep -q "basicsr==" requirements/*.txt; then
            echo "❌ ERROR: basicsr found in requirements!"
            echo "basicsr has CVE-2024-27763 (command injection)"
            echo "It should be excluded by constraints.txt"
            exit 1
          fi
          echo "✓ basicsr correctly excluded (CVE-2024-27763)"
          
          # CVE-2024-73169: sentence-transformers <3.1.0
          RAW_ST_VERSION=$(grep "sentence-transformers==" requirements/*.txt | head -1 | cut -d'=' -f3)
          # Sanitize version string: keep only numeric and dot characters before any suffix
          ST_VERSION=$(printf '%s\n' "$RAW_ST_VERSION" | sed -E 's/[^0-9.].*$//')
          if [ -n "$ST_VERSION" ]; then
            # Simple version check (major.minor)
            MAJOR=$(printf '%s\n' "$ST_VERSION" | cut -d'.' -f1)
            MINOR=$(printf '%s\n' "$ST_VERSION" | cut -d'.' -f2)
            if [ "$MAJOR" -lt 3 ] || ([ "$MAJOR" -eq 3 ] && [ "$MINOR" -lt 1 ]); then
              echo "❌ ERROR: sentence-transformers version $ST_VERSION < 3.1.0"
              echo "Vulnerable to CVE-2024-73169 (arbitrary code execution)"
              exit 1
            fi
            echo "✓ sentence-transformers $ST_VERSION >= 3.1.0 (CVE-2024-73169)"
          fi
          
          echo "✓ All security constraints verified"

  compatibility-check:
    name: Verify Python 3.10 Compatibility Constraints
    runs-on: ubuntu-latest
    needs: validate-compilation
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Check version constraints
        run: |
          echo "Checking Python 3.10 compatibility constraints..."
          
          # networkx <3.5 for Python 3.10
          # Sanitize and parse networkx version
          RAW_NETWORKX_VERSION=$(grep "networkx==" requirements/all.txt | cut -d'=' -f3)
          NETWORKX_VERSION=$(printf '%s\n' "$RAW_NETWORKX_VERSION" | sed -E 's/[^0-9.].*$//')
          NETWORKX_MAJOR=$(printf '%s\n' "$NETWORKX_VERSION" | cut -d'.' -f1)
          NETWORKX_MINOR=$(printf '%s\n' "$NETWORKX_VERSION" | cut -d'.' -f2)
          if [ "$NETWORKX_MAJOR" -gt 3 ] || ([ "$NETWORKX_MAJOR" -eq 3 ] && [ "$NETWORKX_MINOR" -ge 5 ]); then
            echo "❌ ERROR: networkx $NETWORKX_VERSION >= 3.5 (incompatible with Python 3.10)"
            exit 1
          fi
          echo "✓ networkx $NETWORKX_VERSION < 3.5 (Python 3.10 compatible)"
          
          # scikit-learn <1.8 for Python 3.10
          # Sanitize and parse scikit-learn version
          RAW_SKLEARN_VERSION=$(grep "scikit-learn==" requirements/all.txt | cut -d'=' -f3)
          SKLEARN_VERSION=$(printf '%s\n' "$RAW_SKLEARN_VERSION" | sed -E 's/[^0-9.].*$//')
          SKLEARN_MAJOR=$(printf '%s\n' "$SKLEARN_VERSION" | cut -d'.' -f1)
          SKLEARN_MINOR=$(printf '%s\n' "$SKLEARN_VERSION" | cut -d'.' -f2)
          if [ "$SKLEARN_MAJOR" -gt 1 ] || ([ "$SKLEARN_MAJOR" -eq 1 ] && [ "$SKLEARN_MINOR" -ge 8 ]); then
            echo "❌ ERROR: scikit-learn $SKLEARN_VERSION >= 1.8 (incompatible with Python 3.10)"
            exit 1
          fi
          echo "✓ scikit-learn $SKLEARN_VERSION < 1.8 (Python 3.10 compatible)"
          
          echo "✓ All compatibility constraints verified"
