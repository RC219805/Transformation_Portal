# CI pipeline tools (dynamic analysis & release)
# These dependencies are typically only needed in continuous integration or release workflows.
# This file contains abstract requirements with version ranges.
# Run `make compile` in this directory to generate pinned ci.txt
#
# NOTE: Test runner dependencies (pytest, pytest-*, httpx, hypothesis) belong in dev.in,
# NOT here. This file is for CI/CD pipeline *tools* only (security analysis, packaging, reports).
# The root requirements-ci.txt defines test deps inline (must sync with dev.in).

# Security and analysis tools
bandit>=1.7,<2         # static security analyzer
# NOTE: safety removed - transitive NLTK dependency triggered security alerts
# pip-audit (in requirements/security.txt) is the governed blocking scanner
# See ADR-pending: Security toolchain must be locked and deterministic

# Packaging and release tools
build>=1.0,<2          # build wheels/distributions
twine>=4.0,<7          # upload distributions to PyPI
tox>=4.5,<5            # test runner for multiple envs (future compatibility)

# Additional CI utilities
pypdf>=6.15.0          # PDF reports; security floor for GHSA-fwg2-594c-jp42 and GHSA-fp3f-mc75-235c
