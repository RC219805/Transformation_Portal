# Core runtime essentials for Transformation Portal
# This file contains abstract requirements with version ranges.
# Run `make compile` in this directory to generate pinned base.txt

# Core array and image processing
numpy>=1.24,<2.5.0         # upper bound for OpenCV compatibility; see ADR-032
Pillow>=10.3.0,<13         # Security: CVE-2024-28219 fixed in 10.3.0; allows pillow==12.1.1 in lockfiles
scipy>=1.15,<2
scikit-learn>=1.8.0,<2       # classical ML (used in core features)
opencv-python>=4.8.0,<5    # required for depth_writer (core pipeline)

# CLI framework and utilities
typer>=0.10.0,<1           # CLI framework
tqdm>=4.66,<5              # progress bar utility

# Web orchestration service stack (exact pins for API/UI parity)
# Security: keep FastAPI + Starlette on patched baseline for CVE-2025-62727.
fastapi==0.135.1           # orchestrator API framework (compatible with Starlette 0.49.x)
starlette==0.52.1          # direct runtime import + security pin (GHSA-7f5h-v6xp-fcq8)
uvicorn==0.41.0            # ASGI server runtime pin
aiofiles==25.1.0           # async file I/O support for FastAPI file responses

# Schema validation (required for ingest contract)
pydantic>=2.0,<3
jsonschema>=4.21.0,<5

# TIFF image support (essential for batch processing)
tifffile>=2023.7.18,<2027
imagecodecs>=2023.9.18,<2027
