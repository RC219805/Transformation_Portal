# requirements/ml.in
# ML Dependencies Source File
# Generate locked versions with: pip-compile requirements/ml.in -o requirements/ml.txt
#
# These versions are constrained to avoid ResolutionImpossible conflicts
# between controlnet-aux, accelerate, diffusers, and their shared deps.
#
# NOTE: Version ranges here are MORE CONSERVATIVE than pyproject.toml to ensure
# CI stability. pyproject.toml uses broader ranges for user flexibility.
# When updating dependencies, test with these conservative constraints first.

# Core ML framework
torch>=2.0,<3

# Diffusion pipeline
diffusers>=0.20,<1

# ControlNet (allow 0.0.10 for latest features)
# Previously pinned to <0.0.9, but 0.0.10 is compatible with current deps
controlnet-aux>=0.0.6,<0.0.11

# Hugging Face ecosystem (aligned versions)
# NOTE: Conservative bounds here vs pyproject.toml to avoid resolver conflicts
accelerate>=0.20.0,<1
transformers>=4.35.0,<5
# safetensors: Explicitly listed to avoid version conflicts with transformers/diffusers
# and ensure compatibility across the HuggingFace ecosystem
safetensors>=0.3,<1
huggingface-hub>=0.16,<1

# Image processing
Pillow>=10,<12
opencv-python>=4.8,<5

# Real-ESRGAN / GFPGAN - EXCLUDED due to basicsr dependency (CVE-2024-27763)
# The repository uses basicsr_tp vendored package instead.
# realesrgan>=0.3.0,<1  # Requires basicsr - EXCLUDED
# gfpgan>=1.3.8,<2      # Requires basicsr - EXCLUDED

# Semantic search for RAG system
# NOTE: CVE-2024-73169 affects sentence-transformers <3.1.0 (arbitrary code execution via torch.load)
# Use >=3.1.0 to mitigate the vulnerability
sentence-transformers>=3.1.0,<6

# Apple Neural Engine optimization (M-series chips)
# Provides 3-5x speedup on Apple Silicon for depth processing
coremltools>=8.0,<10
