# requirements/ml.in
# ML Dependencies Source File
# Generate locked versions with: pip-compile requirements/ml.in -o requirements/ml.txt
#
# These versions are constrained to avoid ResolutionImpossible conflicts
# between controlnet-aux, accelerate, diffusers, and their shared deps.
#
# NOTE: Version ranges here are MORE CONSERVATIVE than pyproject.toml to ensure
# CI stability. pyproject.toml uses broader ranges for user flexibility.
# When updating dependencies, test with these conservative constraints first.

# Core ML framework
torch>=2.0,<3

# Diffusion pipeline
diffusers>=0.20,<1

# ControlNet (pinned upper bound to avoid huggingface-hub conflicts)
# NOTE: pyproject.toml allows <1, but <0.0.9 is safer for CI resolution
controlnet-aux>=0.0.6,<0.0.9

# Hugging Face ecosystem (aligned versions)
# NOTE: Conservative bounds here vs pyproject.toml to avoid resolver conflicts
accelerate>=0.20.0,<1
transformers>=4.35.0,<5
# safetensors: Explicitly listed to avoid version conflicts with transformers/diffusers
# and ensure compatibility across the HuggingFace ecosystem
safetensors>=0.3,<1
huggingface-hub>=0.16,<1

# Image processing
Pillow>=10,<12
opencv-python>=4.8,<5

# Real-ESRGAN / GFPGAN (note: basicsr excluded via constraints.txt)
realesrgan>=0.3.0,<1
# gfpgan: Face restoration support for Real-ESRGAN workflows
# Not in pyproject.toml ml extras - included here for full ML pipeline support
gfpgan>=1.3.8,<2
