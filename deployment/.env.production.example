# Production Environment Variables for Transformation Portal
# Copy this file to .env.production and customize

# Service Configuration
VERSION=2.0.0
LUX_PORT=8088

# Directories
INPUT_DIR=./data/input
OUTPUT_DIR=./data/output
LOG_DIR=./logs
CONFIG_DIR=./config

# Resource Limits
MEMORY_LIMIT=8G
MEMORY_RESERVATION=4G
CPU_LIMIT=4.0
CPU_RESERVATION=2.0

# Hardening Policy
LUX_HARDEN_MAX_INPUT_BYTES=100000000
LUX_HARDEN_ENABLE_RATE_LIMIT=true
LUX_HARDEN_STAMP_INCLUDE_INPUT_HASH=false

# Observability
LUX_METRICS_ENABLED=1
LUX_METRICS_TOKEN=changeme-secure-token-here
LUX_LOG_FORMAT=json
LUX_LOG_LEVEL=INFO

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-secure-password-here
GRAFANA_ROOT_URL=http://localhost:3000
