{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rc219805.github.io/Transformation_Portal/schemas/phase4/metadata.schema.json",
  "title": "tp.meta.capture.v1 — Capture Metadata Object",
  "description": "Deterministic capture metadata for a single source file. Objects are serialized and hashed canonically; array ordering is enforced by generators (sorted by relative_path).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata_contract_version",
    "relative_path",
    "file_sha256",
    "capture_datetime_utc",
    "camera_make",
    "camera_model",
    "lens_model",
    "gps_latitude",
    "gps_longitude",
    "focal_length_mm",
    "aperture_fnumber",
    "shutter_speed_seconds",
    "exposure_compensation_ev",
    "orientation",
    "extractor",
    "extraction_warnings"
  ],
  "properties": {
    "metadata_contract_version": {
      "type": "string",
      "const": "tp.meta.capture.v1"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Normalized relative path. Must use forward slashes, must not contain '..' segments, and must not begin with './'.",
      "allOf": [
        {
          "pattern": "^(?!\\./).+"
        },
        {
          "pattern": "^(?!.*\\\\).*$"
        },
        {
          "pattern": "^(?!.*(^|/)\\.\\.(?:/|$)).*$"
        }
      ]
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capture_datetime_utc": {
      "description": "UTC timestamp derived from EXIF precedence rules, formatted as YYYY-MM-DDTHH:MM:SSZ, or null when timezone is not safely derivable.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "camera_make": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "camera_model": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "lens_model": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "gps_latitude": {
      "oneOf": [
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "multipleOf": 1e-8
        },
        {
          "type": "null"
        }
      ]
    },
    "gps_longitude": {
      "oneOf": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "multipleOf": 1e-8
        },
        {
          "type": "null"
        }
      ]
    },
    "focal_length_mm": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "multipleOf": 0.001
        },
        {
          "type": "null"
        }
      ]
    },
    "aperture_fnumber": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "multipleOf": 0.001
        },
        {
          "type": "null"
        }
      ]
    },
    "shutter_speed_seconds": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "multipleOf": 1e-6
        },
        {
          "type": "null"
        }
      ]
    },
    "exposure_compensation_ev": {
      "oneOf": [
        {
          "type": "number",
          "minimum": -20,
          "maximum": 20,
          "multipleOf": 0.001
        },
        {
          "type": "null"
        }
      ]
    },
    "orientation": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Horizontal",
            "MirrorHorizontal",
            "Rotate180",
            "MirrorVertical",
            "MirrorHorizontalRotate270CW",
            "Rotate90CW",
            "MirrorHorizontalRotate90CW",
            "Rotate270CW"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "config_fingerprint_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "config_fingerprint_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "extraction_warnings": {
      "type": "array",
      "description": "Stable warning codes only (for example WARN_DATETIME_NO_TZ). Array must be unique and lexicographically sorted by generators.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^WARN_[A-Z0-9_]+$",
        "minLength": 5,
        "maxLength": 128
      }
    }
  }
}
