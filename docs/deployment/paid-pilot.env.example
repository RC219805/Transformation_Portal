TP_ORCHESTRATOR_STATE_BACKEND=postgres
TP_DATABASE_URL=postgresql+asyncpg://tp:tp_dev_password@127.0.0.1:5432/transformation_portal
TP_TEST_POSTGRES_URL=postgresql+asyncpg://tp:tp_dev_password@127.0.0.1:5432/transformation_portal

TP_ORCHESTRATOR_QUEUE_BACKEND=redis
TP_ORCHESTRATOR_EXECUTION_ROOT=/srv/transformation-portal/execution
TP_REDIS_URL=redis://127.0.0.1:6379/0
TP_TEST_REDIS_URL=redis://127.0.0.1:6379/0

TP_FRONTDOOR_SESSION_STORE=redis
TP_FRONTDOOR_REDIS_URL=redis://127.0.0.1:6379/0

TP_ARTIFACT_STORE=s3
TP_ARTIFACT_ENDPOINT_URL=http://127.0.0.1:9000
TP_TEST_S3_URL=http://127.0.0.1:9000
TP_ARTIFACT_BUCKET=tp-artifacts-pilot
TP_TEST_S3_BUCKET=tp-artifacts-pilot
TP_ARTIFACT_REGION=us-east-1
AWS_ACCESS_KEY_ID=tp_minio
AWS_SECRET_ACCESS_KEY=tp_minio_password

MINIO_ROOT_USER=tp_minio
MINIO_ROOT_PASSWORD=tp_minio_password

# Optional authenticated tenant isolation (disabled preserves single-tenant mode).
# Enable on both backend and frontdoor; share a dedicated random secret >=32 bytes.
# Never reuse TP_API_KEY / TP_BACKEND_API_KEY for identity signing.
TP_PILOT_CONTROL_PLANE_ENABLED=0
TP_FRONTDOOR_IDENTITY_SECRET=
# Backend-only membership from verified Cloudflare Access email; no client selectors.
TP_PILOT_ACTOR_TENANTS_JSON={}

# Postgres retained SSE events per job; positive bound, aligned on API/worker hosts.
TP_ORCHESTRATOR_EVENT_RETENTION_PER_JOB=4096
