{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.transformation-portal.dev/archive/archive_manifest_v2.schema.json",
  "title": "tp.archive.manifest.v2",
  "type": "object",
  "required": [
    "origin_drive",
    "partition",
    "relpath",
    "size_bytes",
    "sha256",
    "hash_status",
    "created_utc",
    "modified_utc",
    "accessed_utc",
    "created_source",
    "mime",
    "extension",
    "rights_flags",
    "owner",
    "collection_id",
    "provenance_id"
  ],
  "properties": {
    "origin_drive": { "type": "string" },
    "partition": { "type": "string" },
    "relpath": { "type": "string", "minLength": 1 },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string" },
    "hash_status": {
      "type": "string",
      "enum": ["ok", "missing", "unreadable", "skipped", ""]
    },
    "created_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "modified_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "accessed_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "created_source": { "type": "string", "minLength": 1 },
    "mime": { "type": "string", "minLength": 1 },
    "extension": { "type": "string" },
    "rights_flags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owner": { "type": "string", "minLength": 1 },
    "collection_id": { "type": "string", "minLength": 1 },
    "provenance_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
