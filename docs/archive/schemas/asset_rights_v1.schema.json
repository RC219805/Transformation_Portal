{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.transformation-portal.dev/archive/asset_rights_v1.schema.json",
  "title": "Asset rights classification row",
  "type": "object",
  "required": [
    "relpath",
    "rights_flags",
    "owner"
  ],
  "properties": {
    "relpath": {
      "type": "string",
      "minLength": 1
    },
    "rights_flags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "rights_rule_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
