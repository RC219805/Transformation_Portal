{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hash_manifest_summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hash_algorithm",
    "hash_manifest_schema_version",
    "rows_total",
    "hashed_ok",
    "missing",
    "unreadable",
    "skipped",
    "total_bytes_hashed"
  ],
  "properties": {
    "hash_algorithm": {
      "type": "string",
      "const": "sha256"
    },
    "hash_manifest_schema_version": {
      "type": "string"
    },
    "rows_total": {
      "type": "integer",
      "minimum": 0
    },
    "hashed_ok": {
      "type": "integer",
      "minimum": 0
    },
    "missing": {
      "type": "integer",
      "minimum": 0
    },
    "unreadable": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes_hashed": {
      "type": "integer",
      "minimum": 0
    }
  }
}
