{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source_taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "category",
          "provenance_type",
          "license_class",
          "synthetic",
          "tdm_compliance_note"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "licensed_private_dataset",
              "other",
              "public_dataset",
              "synthetic",
              "user_provided",
              "web_scraped"
            ]
          },
          "provenance_type": {
            "type": "string",
            "enum": [
              "first_party",
              "mixed",
              "third_party"
            ]
          },
          "license_class": {
            "type": "string",
            "minLength": 1
          },
          "synthetic": {
            "type": "boolean"
          },
          "tdm_compliance_note": {
            "type": "string",
            "minLength": 1
          },
          "crawler": {
            "type": "string",
            "minLength": 1
          },
          "collection_period": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          },
          "top_domains": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "geographic_coverage": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "record_count_estimate": {
            "type": "integer",
            "minimum": 0
          },
          "byte_count_estimate": {
            "type": "integer",
            "minimum": 0
          },
          "processing_disclosure": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "category": {
                  "const": "web_scraped"
                }
              },
              "required": [
                "category"
              ]
            },
            "then": {
              "properties": {
                "top_domains": {
                  "minItems": 1
                }
              },
              "required": [
                "crawler",
                "collection_period",
                "top_domains"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "synthetic"
                }
              },
              "required": [
                "category"
              ]
            },
            "then": {
              "properties": {
                "synthetic": {
                  "const": true
                }
              },
              "required": [
                "synthetic"
              ]
            }
          }
        ]
      }
    }
  }
}
