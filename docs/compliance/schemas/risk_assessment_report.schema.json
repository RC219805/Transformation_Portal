{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schema_version": "1.0.0",
  "title": "risk_assessment_report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "regulatory_regime",
    "assessment_version",
    "purpose_specificity",
    "categories_processed",
    "sensitive_categories",
    "operational_elements",
    "benefits",
    "negative_impacts",
    "safeguards",
    "review_approval",
    "next_review_due"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "regulatory_regime": {
      "type": "string",
      "enum": [
        "CPPA_CCPA_2026"
      ]
    },
    "assessment_version": {
      "type": "string",
      "minLength": 1
    },
    "purpose_specificity": {
      "type": "string",
      "minLength": 1
    },
    "categories_processed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sensitive_categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operational_elements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_methods",
        "retention_policy",
        "recipients",
        "population_scale_estimate"
      ],
      "properties": {
        "collection_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retention_policy": {
          "type": "string",
          "minLength": 1
        },
        "recipients": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "population_scale_estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "estimated_records",
            "estimated_data_subjects"
          ],
          "properties": {
            "estimated_records": {
              "type": "integer",
              "minimum": 0
            },
            "estimated_data_subjects": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "geographic_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "benefits": {
      "type": "string",
      "minLength": 1
    },
    "negative_impacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safeguards": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pets_used": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "role",
        "date",
        "approval_status"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "approval_status": {
          "type": "string",
          "enum": [
            "approved",
            "approved_with_conditions",
            "rejected"
          ]
        }
      }
    },
    "next_review_due": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
