{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.transformation-portal.dev/machine_mode/tp.meta.machine.v1/error.schema.json",
  "title": "Typed Ingest Error",
  "description": "Typed ingest-domain error object emitted in machine-mode JSON payloads.",
  "type": "object",
  "required": [
    "type",
    "message",
    "exit_code",
    "priority"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string"
    },
    "exit_code": {
      "$ref": "https://schemas.transformation-portal.dev/machine_mode/tp.meta.machine.v1/exit_code.schema.json"
    },
    "priority": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
