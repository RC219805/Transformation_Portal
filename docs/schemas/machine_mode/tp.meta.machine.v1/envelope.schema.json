{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.transformation-portal.dev/machine_mode/tp.meta.machine.v1/envelope.schema.json",
  "title": "Machine Mode Envelope",
  "description": "Top-level machine-mode envelope for tp.meta.machine.v1.",
  "type": "object",
  "required": [
    "schema",
    "command",
    "success",
    "exit_code",
    "data",
    "error"
  ],
  "properties": {
    "schema": {
      "const": "tp.meta.machine.v1"
    },
    "command": {
      "type": "string",
      "enum": [
        "check-system",
        "extract",
        "validate",
        "extract-batch"
      ]
    },
    "success": {
      "type": "boolean"
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "data": {
      "type": "object"
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://schemas.transformation-portal.dev/machine_mode/tp.meta.machine.v1/error.schema.json"
        },
        {
          "$ref": "#/$defs/command_error"
        }
      ]
    }
  },
  "$defs": {
    "command_error": {
      "type": "object",
      "description": "Fallback command-level exception payload for non-ingest errors.",
      "required": [
        "type",
        "message"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "success": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
