    "archive_index": { "type": "string" },
    "archive_root": { "type": "string" },
    "out_root": { "type": "string" },
    "subset_root": { "type": "string" },
    "eval_command": { "type": ["string", "null"] },
    "validate_schemas": { "type": "boolean" },
    "allow_writable_subset": { "type": "boolean" },
    "stdout": { "type": "string" },
