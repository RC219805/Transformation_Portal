{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.transformation-portal.dev/machine_mode/tp.archive.machine.v1/data.tool-exec.schema.json",
  "title": "Generic Tool Execution Data",
  "type": "object",
  "required": [
    "tool",
    "arguments",
    "stdout",
    "stderr"
  ],
  "properties": {
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
