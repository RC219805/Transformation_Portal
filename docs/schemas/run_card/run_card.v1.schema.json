{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rc219805.github.io/Transformation_Portal/docs/schemas/run_card/run_card.v1.schema.json",
  "title": "Run Card v1",
  "description": "Deterministic run card contract for lux_depth_v3 batch execution metadata and artifact integrity.",
  "type": "object",
  "required": [
    "artifact_index",
    "artifact_merkle_root",
    "backend_selection",
    "batch_id",
    "config_fingerprint",
    "end_time",
    "environment",
    "error_count",
    "git_revision",
    "outliers",
    "runtime_stats",
    "start_time",
    "success_count",
    "total_images"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "config_fingerprint": {
      "type": "object",
      "required": [
        "depth_device",
        "depth_quantization",
        "model_variant",
        "preset",
        "sha256",
        "v2_device",
        "v2_preset",
        "v2_upscaler_backend"
      ],
      "properties": {
        "model_variant": {
          "type": "string",
          "minLength": 1
        },
        "depth_quantization": {
          "type": "string",
          "minLength": 1
        },
        "depth_device": {
          "type": "string",
          "minLength": 1
        },
        "preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "v2_preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "v2_device": {
          "type": [
            "string",
            "null"
          ]
        },
        "v2_upscaler_backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "backend_selection": {
      "type": "object",
      "required": [
        "device",
        "model_id",
        "requested",
        "resolved"
      ],
      "properties": {
        "requested": {
          "type": "string",
          "minLength": 1
        },
        "resolved": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "backend_summary": {
      "type": "object",
      "required": [
        "requested_backend",
        "final_backends_used",
        "fallback_images",
        "semantic_fallback_images",
        "operational_fallback_images"
      ],
      "properties": {
        "requested_backend": {
          "type": "string",
          "minLength": 1
        },
        "final_backends_used": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fallback_images": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_fallback_images": {
          "type": "integer",
          "minimum": 0
        },
        "operational_fallback_images": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "machine",
        "platform",
        "python_version"
      ],
      "properties": {
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "git_revision": {
      "type": "object",
      "required": [
        "v2",
        "v3"
      ],
      "properties": {
        "v2": {
          "type": [
            "string",
            "null"
          ]
        },
        "v3": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "runtime_stats": {
      "type": "object",
      "required": [
        "count",
        "max",
        "mean",
        "median",
        "min",
        "total"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "mean": {
          "type": "number",
          "minimum": 0
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "median": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "outliers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "image",
          "metadata"
        ],
        "properties": {
          "image": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object",
            "required": [
              "is_outlier",
              "median_runtime_s",
              "ratio_to_median",
              "runtime_s",
              "threshold_multiplier"
            ],
            "properties": {
              "is_outlier": {
                "type": "boolean"
              },
              "runtime_s": {
                "type": "number",
                "minimum": 0
              },
              "median_runtime_s": {
                "type": "number",
                "minimum": 0
              },
              "ratio_to_median": {
                "type": "number",
                "minimum": 0
              },
              "threshold_multiplier": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "total_images": {
      "type": "integer",
      "minimum": 0
    },
    "success_count": {
      "type": "integer",
      "minimum": 0
    },
    "error_count": {
      "type": "integer",
      "minimum": 0
    },
    "artifact_index": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_type",
          "path",
          "relative_path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "artifact_merkle_root": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
