{
  "schema": "evalsuite.v0",
  "schema_version": "0.0.0",
  "suite_id": "indoor-day-sample",
  "suite_version": "0.1.0",
  "taxonomy_id": "taxonomy.v0",
  "taxonomy_version": "0.0.0",
  "filters": {
    "metadata": {
      "camera_model": ["Sony A7R IV"],
      "iso_min": 100,
      "iso_max": 1600,
      "width_min": 1024,
      "height_min": 768
    },
    "labels": [
      { "label_key": "environment", "op": "==", "value": "indoor" },
      { "label_key": "lighting", "op": "in", "value": ["day", "mixed"] }
    ],
    "quality": {
      "blur_score_max": 0.4,
      "clip_highlights_frac_max": 0.1
    }
  },
  "dedup_policy": {
    "exclude_same_cluster": true,
    "cluster_method": "phash",
    "max_per_cluster": 2
  },
  "limit": 100,
  "order_by": "capture_timestamp_utc",
  "order_direction": "asc",
  "artifact_requirements": ["raw", "preview_jpeg"]
}
